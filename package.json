{
  "name": "storydesk",
  "version": "0.1.0",
  "private": true,
  "description": "Local macOS virtual display streaming to browser receivers and Chromecast devices.",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:helper && concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:electron\"",
    "dev:electron": "wait-on http://127.0.0.1:5173 && npm run build:electron && STORYDESK_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run build:helper && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:helper": "bash scripts/build-helper.sh",
    "start": "npm run build && electron .",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "bonjour-service": "^1.4.2",
    "castv2-client": "^1.2.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "overrides": {
    "protobufjs": "7.6.5"
  }
}
